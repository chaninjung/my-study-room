FROM python:3.13-slim

WORKDIR /app

COPY services/coding-test-runner/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services/coding-test-runner/app.py services/coding-test-runner/runner.py ./

ENV PYTHONUNBUFFERED=1
EXPOSE 10000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "10000"]
